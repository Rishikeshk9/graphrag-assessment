QDRANT_URL=http://localhost:6333
# Leave empty for local Docker Qdrant. Set the cloud cluster API key in production.
QDRANT_API_KEY=
QDRANT_CHILDREN_COLLECTION=graphrag_children
QDRANT_PARENTS_COLLECTION=graphrag_parents
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=qwen3-embedding
OLLAMA_GRAPH_MODEL=qwen3:4b
OLLAMA_CHAT_MODEL=qwen2.5:7b-instruct
# OpenRouter can generate answers and extract graph facts when selected in the UI.
# Keep this key in backend/.env, never in git.
GRAPH_EXTRACTION_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
OPENROUTER_CHAT_MODEL=stealth/ox-alpha
OPENROUTER_GRAPH_MODEL=stealth/ox-alpha
OPENROUTER_GRAPH_RESPONSE_FORMAT=json_object
OPENROUTER_SITE_URL=http://127.0.0.1:5173
OPENROUTER_APP_NAME=GraphRAG Assessment
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=local-rag-password
GRAPH_NAMESPACE=graphrag-assessment
PARENT_CHUNK_TOKENS=1000
PARENT_CHUNK_OVERLAP_TOKENS=100
CHILD_CHUNK_TOKENS=200
CHILD_CHUNK_OVERLAP_TOKENS=40
GRAPH_EXTRACTION_CONCURRENCY=4
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
